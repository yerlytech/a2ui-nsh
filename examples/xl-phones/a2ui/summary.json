  {
    "version": "1.0",
    "updateComponents": {
      "surfaceId": "summary",
      "components": [
        {
          "id": "root",
          "component": "Card",
          "title": "crm.title.customer_summary",
          "heading": "Cobalt Harbor Supply",
          "subtitle": "Customer since Jan 2026",
          "children": ["kpis", "chart", "detail"]
        },
        {
          "id": "kpis",
          "component": "Columns",
          "widths": [1, 1],
          "children": ["annual", "open_deals"]
        },
        {
          "id": "annual",
          "component": "Metric",
          "label": "crm.kpi.annual_value",
          "value": { "@path": "/kpi/annualValue" },
          "format": "money",
          "change": { "@path": "/kpi/annualChange" },
          "better": "up",
          "accent": "accent",
          "hint": "crm.kpi.this_year",
          "icon": "money"
        },
        {
          "id": "open_deals",
          "component": "Metric",
          "label": "crm.kpi.open_deals",
          "value": { "@path": "/kpi/openDeals" },
          "format": "count",
          "change": { "@path": "/kpi/openDealsChange" },
          "better": "down",
          "accent": "rose",
          "hint": "crm.kpi.this_month"
        },
        {
          "id": "chart",
          "component": "Chart",
          "kind": "bars",
          "label": "crm.chart.quarterly",
          "data": { "@path": "/chart/quarterly" },
          "format": "money"
        },
        {
          "id": "detail",
          "component": "Detail",
          "record": { "@path": "/customer" },
          "rows": [
            { "field": "name", "label": "crm.field.name" },
            { "field": "email", "label": "crm.field.email" },
            { "field": "phone", "label": "crm.field.phone" },
            { "field": "segment", "label": "crm.field.segment", "enumPrefix": "crm.segment." },
            { "field": "annualValue", "label": "crm.field.amount", "format": "money" },
            { "field": "contractStart", "label": "crm.field.contract_start", "format": "date" },
            { "field": "taxId", "label": "crm.field.tax_id" },
            { "field": "paymentTerms", "label": "crm.field.payment_terms", "enumPrefix": "crm.terms." },
            { "field": "address", "label": "crm.field.address" },
            { "field": "city", "label": "crm.field.city" },
            { "field": "country", "label": "crm.field.country" },
            { "field": "notes", "label": "crm.field.notes" }
          ],
          "skipEmpty": true,
          "update": "crm.customer.update"
        }
      ]
    }
  },
