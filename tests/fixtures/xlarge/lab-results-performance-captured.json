              { "field": "code", "label": "lab_results.field.method" },
              { "field": "parameter", "grow": true, "label": "lab_results.field.parameter" },
              { "field": "entered", "format": "number", "label": "lab_results.field.entered_count" },
              { "field": "approved", "format": "number", "label": "lab_results.field.approved_count" },
              { "field": "averageHours", "format": "decimal", "label": "lab_results.field.average_hours" }
            ],
            "rows": { "@path": "/performance/methods" }
          },
          {
            "id": "weeks_card",
