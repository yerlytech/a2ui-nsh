                "label": "lab_results.field.calibration",
                "tones": {
                  "archived": "neutral",
                  "failed": "danger",
                  "in_date": "success",
                  "missing": "warning",
                  "no_such_equipment": "neutral",
                  "not_yet_valid": "warning",
                  "overdue": "danger",
                  "parent_not_usable": "danger",
                  "retired": "neutral"
                }
              },
              { "field": "dueOn", "format": "date", "label": "lab_results.field.calibration_due_on" }
            ],
            "rows": { "@path": "/performance/instruments" }
          },
          {
            "id": "methods_card",
            "component": "Card",
            "children": ["methods_csv", "methods"],
            "title": "lab_results.title.methods"
