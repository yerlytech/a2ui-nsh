      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "lab_results.performance",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "children": [
              "download",
              "when",
              "cut",
              "reported",
              "average",
              "median",
              "p90",
              "on_time",
              "overdue",
              "trend",
              "analysts_card",
              "instruments_card",
              "methods_card",
              "weeks_card"
            ],
            "pageTitle": "lab_results.title.performance",
            "title": "lab_results.title.performance"
          },
          {
            "id": "download",
            "component": "Button",
            "action": "export:lab_results.performance?shape=xlsx",
            "icon": "download",
            "label": "lab_results.action.download_xlsx"
          },
          {
            "id": "when",
            "component": "Form",
            "children": ["period", "from", "to"],
            "row": true,
            "submit": "screen:lab_results.performance",
            "submitLabel": "period.action.show"
          },
          {
            "id": "period",
            "component": "Field",
            "default": { "@path": "/_period/preset" },
            "field": "period",
            "input": "choice",
            "label": "period.field.period",
            "optionPrefix": "period.preset.",
            "options": [
              "today",
              "this_week",
              "this_month",
              "last_month",
              "this_quarter",
              "this_year",
              "last_7_days",
              "last_30_days",
              "between"
            ]
          },
          {
            "id": "from",
            "component": "Field",
            "default": { "@path": "/_period/from" },
            "field": "from",
            "input": "date",
            "label": "period.field.from"
          },
          {
            "id": "to",
            "component": "Field",
            "default": { "@path": "/_period/to" },
            "field": "to",
            "input": "date",
            "label": "period.field.to"
          },
          {
            "id": "cut",
            "component": "Text",
            "code": "lab_results.text.performance_cut",
