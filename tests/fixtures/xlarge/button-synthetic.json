{
  "source": "synthetic, no real xlarge screen yet",
  "messages": [
    {
      "version": "1.0",
      "createSurface": { "surfaceId": "synthetic.button", "catalogId": "tech.yerly.xlarge/v1" }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "synthetic.button",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "title": "crm.title.deal",
            "children": ["win", "drop", "save"]
          },
          {
            "id": "win",
            "component": "Button",
            "action": "crm.win_deal",
            "label": "crm.action.win",
            "labelParams": { "title": "Forklift fleet" },
            "icon": "check",
            "context": { "id": "d1", "amount": "25000.50" }
          },
          {
            "id": "drop",
            "component": "Button",
            "action": "crm.drop_deal",
            "label": "crm.action.drop",
            "variant": "danger",
            "confirm": true,
            "context": { "id": "d1" }
          },
          {
            "id": "save",
            "component": "Button",
            "action": "crm.deal.save",
            "label": "crm.action.save",
            "variant": "primary",
            "context": { "id": { "path": "/deal/id" }, "source": "web" },
            "version": { "@path": "/deal/version" },
            "after": "crm.deals"
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "synthetic.button",
        "path": "/deal",
        "value": { "id": "d1", "version": 3 }
      }
    }
  ]
}
